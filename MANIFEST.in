include LICENSE
include README.md
include THIRD_PARTY_NOTICES.md
include pyproject.toml
include run_gui.py
recursive-include tests *.py
recursive-include benchmarks *.py
recursive-include benchmark-results *.json
recursive-include packaging *.py *.md
recursive-include src/any3dview/gpu/tkgl *

prune build
prune dist
prune .pytest_cache
global-exclude *.py[cod]
global-exclude __pycache__

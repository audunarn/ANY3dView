{"id": "effect-c1436168-71bd-59b7-aaa4-5740c3a11c3f", "sessionId": "fa4f1d4c-0b72-534f-d894-716a6ea09ae7", "turnId": "turn-859e7767a6871daa8f5c61af8f0fd007", "createdAt": 1792409173852, "updatedAt": 1792409173915, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "file_system.read_file", "detail": {"toolName": "file_system.read_file", "display": {"summary": "Reading C:\\Github\\ANY3dView\\src\\any3dview\\retained_viewer.py", "content": null, "suffix": "", "verb": "Reading", "message": "C:\\Github\\ANY3dView\\src\\any3dview\\retained_viewer.py", "settledVerb": "Read", "settledMessage": "C:\\Github\\ANY3dView\\src\\any3dview\\retained_viewer.py", "statusText": "Reading file"}, "kind": "file_read", "input": {"filePath": "C:\\Github\\ANY3dView\\src\\any3dview\\retained_viewer.py", "offset": 426, "limit": 30}}, "state": {"status": "completed", "output": {"filePath": "C:\\Github\\ANY3dView\\src\\any3dview\\retained_viewer.py", "content": "        depth = (value - self.camera.position).dot(forward)\r\n        return float(projected[0]), float(projected[1]), float(depth)\r\n\r\n\r\n    def _project_world_points(self, world, frame):\r\n        \"\"\"Vectorized project_point over a world-space point array.\r\n\r\n        Returns ``(screen, visible)`` where screen rows are ``(x, y, depth)``\r\n        and visible marks rows strictly between the camera's near and far\r\n        planes, matching project_point's ``None`` contract.\r\n        \"\"\"\r\n        camera = (np.asarray(world, dtype=float).reshape((-1, 3)) - frame.origin) @ frame.basis.T\r\n        depth = camera[:, 2]\r\n        visible = (depth > frame.near) & (depth < frame.far)\r\n        safe = np.where(visible, depth, 1.0)\r\n        x = (camera[:, 0] * frame.scale / frame.aspect / safe + 1.0) * 0.5 * frame.width\r\n        y = (1.0 - camera[:, 1] * frame.scale / safe) * 0.5 * frame.height\r\n        return np.stack((x, y, depth), axis=1), visible\r\n\r\n    def _project_point_with_frame(self, point, frame):\r\n        \"\"\"Single-point projection reusing frame-local camera state.\"\"\"\r\n        value = as_point(point)\r\n        camera = (np.asarray(value.to_tuple()) - frame.origin) @ frame.basis.T\r\n        depth = float(camera[2])\r\n        if depth <= frame.near or depth >= frame.far:\r\n            return None\r\n        return (\r\n            float((camera[0] * frame.scale / frame.aspect / depth + 1.0) * 0.5 * frame.width),\r\n            float((1.0 - camera[1] * frame.scale / depth) * 0.5 * frame.height),\r\n            depth,\r\n", "numLines": 30, "startLine": 426, "requestedOffset": 426, "requestedLimit": 30, "totalLines": null, "wasTruncated": true}, "outputText": "", "durationMs": 0.0, "display": {"success": true, "verb": "Read", "message": "30 lines from C:\\Github\\ANY3dView\\src\\any3dview\\retained_viewer.py", "warnings": [], "approvalNote": "Auto-approved: allowed by your permission rules", "suffix": "(truncated)"}, "decision": "execute", "approvalType": "always", "approvalSource": "smart"}}

fier(self, notifier: Optional[Callable[[], None]]) -> None:\n        \"\"\"Attach or detach the wakeup hook (owner thread setup only).\"\"\"\n\n        self._notifier = notifier\n\n    def submit(\n        self,\n        callback: Callable[..., Any],\n        /,\n        *args: Any,\n        **kwargs: Any,\n    ) -> None:\n        if self._closed:\n            raise RuntimeError(\"viewer scheduler has been closed\")\n        if not callable(callback):\n            raise TypeError(\"callback must be callable\")\n        self._queue.put((callback, args, kwargs))\n        notifier = self._notifier\n        if notifier is not None:\n            try:\n                notifier()\n            except Exception:\n                # The payload is already queued; a broken wakeup must not\n                # lose it or crash the producing thread.  Any later drain\n                # (or the next submission's wakeup) still executes it.\n                pass\n\n    def pending(self) -> bool:\n        \"\"\"Report whether queued work remains (approximate across threads).\"\"\"\n\n        return not self._queue.empty()\n\n    def drain(self, limit: int = 1024) -> int:\n        if get_ident() != self._owner_thread:\n            raise RuntimeError(\"viewer updates must be drained on the owning thread\")\n        completed = 0\n        while completed < max(1, int(limit)):\n            try:\n                callback, args, kwargs = self._queue.get_nowait()\n            except Empty:\n                return completed\n            callback(*args, **kwargs)\n            completed += 1\n        if not self._queue.empty():\n            # The bounded FIFO still holds work; re-queue the wakeup so the\n            # remainder is drained without waiting for a new submission.\n            notifier = self._notifier\n            if notifier is not None:\n                try:\n                    notifier()\n                except Exception:\n                    pass\n        return completed\n\n    def close(self) -> None:\n        # Detach first so no wakeup can observe the half-closed state.\n        self._notifier = None\n        self._closed = True\n        while True:\n            try:\n                self._queue.get_nowait()\n            except Empty:\n                return\n\n\n__all__ = [\"ViewerScheduler\"]\n", "numLines": 94, "startLine": 1, "requestedOffset": null, "requestedLimit": 2000, "totalLines": null, "wasTruncated": false}, "outputText": "", "durationMs": 0.0, "display": {"success": true, "verb": "Read", "message": "94 lines from C:\\Github\\ANY3dView\\src\\any3dview\\scheduler.py", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}

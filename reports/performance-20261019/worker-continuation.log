\"\"\"\r\nfrom types import SimpleNamespace\r\nfrom concurrent.futures import ThreadPoolExecutor\r\nfrom threading import get_ident\r\nimport pytest\r\npytest.importorskip('PySide6')\r\nfrom PySide6.QtCore import QObject,QCoreApplication,QEventLoop,QTimer\r\nfrom any3dview.qt import QtViewer\r\nfrom any3dview.scheduler import ViewerScheduler\r\n\r\nclass Pump(QObject):\r\n    _start_update_pump=QtViewer._start_update_pump\r\n    _poll_updates=QtViewer._poll_updates\r\n    after_cancel=QtViewer.after_cancel\r\n    destroy=QtViewer.destroy\r\n    _cancel_hover=QtViewer._cancel_hover\r\n    def __init__(self):\r\n        super().__init__();self._closed=False;self._update_poll_id=None;self._timers=set()\r\n        self._update_scheduler=ViewerScheduler();self.redraws=0\r\n        self._hover_timer=None;self._pending_hover=None\r\n        self._renderer=SimpleNamespace(release=lambda:None)\r\n    def redraw(self):\r\n        if not self._closed:self.redraws+=1\r\n    def stop_animation(self):pass\r\n    def _release_gl(self):pass\r\n    def hide(self):pass\r\n\r\n@pytest.fixture\r\ndef pump():\r\n    app=QCoreApplication.instance() or QCoreApplication([])\r\n    p=Pump();yield p\r\n    if not p._closed:p.destroy()\r\n\r\n\r\ndef test_one_timer_across_repeated_start_and_idle_ticks(pump):\r\n    pump._start_update_pump();timer=pump._update_poll_id\r\n    for _ in range(100):\r\n        pump._start_update_pump();pump._poll_updates()\r\n    assert pump._timers=={timer}\r\n    assert len(pump.findChildren(QTimer))==1\r\n    assert timer.isActive() and timer.interval()==2 and not timer.isSingleShot()\r\n    assert pump.redraws==0\r\n\r\n\r\ndef test_worker_submission_runs_fifo_on_owner_through_real_timer(pump):\r\n    seen=[];owner=get_ident();pump._start_update_pump()\r\n    with ThreadPoolExecutor(max_workers=1) as pool:\r\n        pool.submit(lambda:[pump._update_scheduler.submit(lambda i=i:seen.append((i,get_ident()))) for i in range(4)]).result()\r\n    assert seen==[]\r\n    loop=QEventLoop();QTimer.singleShot(20,loop.quit);loop.exec()\r\n    assert seen==[(i,owner) for i in range(4)]\r\n    assert pump.redraws==1\r\n\r\n\r\ndef test_drain_limit_retained_and_next_tick_finishes(pump):\r\n    seen=[]\r\n    for i in range(1025):pump._update_scheduler.submit(seen.append,i)\r\n    pump._start_update_pump()\r\n    assert seen==list(range(1024))\r\n    pump._poll_updates();assert seen==list(range(1025))\r\n    assert pump.redraws==2\r\n\r\n\r\ndef test_destroy_stops_timer_rejects_submissions_and_stale_tick(pump):\r\n    pump._start_update_pump();timer=pump._update_poll_id;seen=[]\r\n    pump._update_scheduler.submit(seen.append,'stale')\r\n    pump.destroy()\r\n    assert not timer.isActive() and not pump._timers\r\n    pump._poll_updates();pump._start_update_pump();assert seen==[]\r\n    with pytest.raises(RuntimeError,match='closed'):pump._update_scheduler.submit(lambda:None)\r\n\r\n\r\ndef test_destroy_during_drain_discards_remaining_callbacks(pump):\r\n    seen=[];pump._update_scheduler.submit(pump.destroy)\r\n    pump._update_scheduler.submit(seen.append,'stale')\r\n    pump._start_update_pump()\r\n    assert pump._closed and seen==[] and pump.redraws==0\r\n    assert not pump._timers\r\n\r\n\r\ndef test_worker_cannot_drain_or_execute_callback(pump):\r\n    seen=[];pump._update_scheduler.submit(seen.append,'owner')\r\n    with ThreadPoolExecutor(max_workers=1) as pool:\r\n        with pytest.raises(RuntimeError,match='owning thread'):pool.submit(pump._poll_updates).result()\r\n    assert seen==[]\r\n    pump._poll_updates();assert seen==['owner']\r\n\r\n\r\ndef test_initial_callback_failure_does_not_leave_running_timer(pump):\r\n    def fail():raise ValueError('bad update')\r\n    pump._update_scheduler.submit(fail)\r\n    with pytest.raises(ValueError,match='bad update'):pump._start_update_pump()\r\n    assert pump._update_poll_id is None and not pump._timers\r\n    pump._start_update_pump();assert pump._update_poll_id.isActive()\r\n====\nfrom threading import Thread\n\nimport pytest\n\nfrom any3dview import ViewerScheduler\n\n\ndef test_scheduler_hands_cross_thread_payload_to_owner_thread():\n    scheduler = ViewerScheduler()\n    values = []\n    producer = Thread(target=scheduler.submit, args=(values.append, (\"frame\", 7)))\n    producer.start()\n    producer.join()\n\n    assert values == []\n    assert scheduler.drain() == 1\n    assert values == [(\"frame\", 7)]\n\n\ndef test_closed_scheduler_rejects_new_work():\n    scheduler = ViewerScheduler()\n    scheduler.close()\n    with pytest.raises(RuntimeError, match=\"closed\"):\n        scheduler.submit(lambda: None)\n", "stderr": "", "output": "", "truncated": false}, "outputText": "222:        self._update_scheduler = ViewerScheduler()\n223:        self._update_poll_id: Optional[str] = None\n234:        self._update_scheduler.submit(callback, *args, **kwargs)\n237:    def _poll_updates(self) -> None:\n240:        completed = self._update_scheduler.drain()\n244:        self._update_poll_id = self.after(2, self._poll_updates)\n====\n\"\"\"Real Qt timer and shared scheduler checks, with no QWidget or GPU context.\"\"\"\r\nfrom types import SimpleNamespace\r\nfrom concurrent.futures import ThreadPoolExecutor\r\nfrom threading import get_ident\r\nimport pytest\r\npytest.importorskip('PySide6')\r\nfrom PySide6.QtCore import QObject,QCoreApplication,QEventLoop,QTimer\r\nfrom any3dview.qt import QtViewer\r\nfrom any3dview.scheduler import ViewerScheduler\r\n\r\nclass Pump(QObject):\r\n    _start_update_pump=QtViewer._start_update_pump\r\n    _poll_updates=QtViewer._poll_updates\r\n    after_cancel=QtViewer.after_cancel\r\n    destroy=QtViewer.destroy\r\n    _cancel_hover=QtViewer._cancel_hover\r\n    def __init__(self):\r\n        super().__init__();self._closed=False;self._update_poll_id=None;self._timers=set()\r\n        self._update_scheduler=ViewerScheduler();self.redraws=0\r\n        self._hover_timer=None;self._pending_hover=None\r\n        self._renderer=SimpleNamespace(release=lambda:None)\r\n    def redraw(self):\r\n        if not self._closed:self.redraws+=1\r\n    def stop_animation(self):pass\r\n    def _release_gl(self):pass\r\n    def hide(self):pass\r\n\r\n@pytest.fixture\r\ndef pump():\r\n    app=QCoreApplication.instance() or QCoreApplication([])\r\n    p=Pump();yield p\r\n    if not p._closed:p.destroy()\r\n\r\n\r\ndef test_one_timer_across_repeated_start_and_idle_ticks(pump):\r\n    pump._start_update_pump();timer=pump._update_poll_id\r\n    for _ in range(100):\r\n        pump._start_update_pump();pump._poll_updates()\r\n    assert pump._timers=={timer}\r\n    assert len(pump.findChildren(QTimer))==1\r\n    assert timer.isActive() and timer.interval()==2 and not timer.isSingleShot()\r\n    assert pump.redraws==0\r\n\r\n\r\ndef test_worker_submission_runs_fifo_on_owner_through_real_timer(pump):\r\n    seen=[];owner=get_ident();pump._start_update_pump()\r\n    with ThreadPoolExecutor(max_workers=1) as pool:\r\n        pool.submit(lambda:[pump._update_scheduler.submit(lambda i=i:seen.append((i,get_ident()))) for i in range(4)]).result()\r\n    assert seen==[]\r\n    loop=QEventLoop();QTimer.singleShot(20,loop.quit);loop.exec()\r\n    assert seen==[(i,owner) for i in range(4)]\r\n    assert pump.redraws==1\r\n\r\n\r\ndef test_drain_limit_retained_and_next_tick_finishes(pump):\r\n    seen=[]\r\n    for i in range(1025):pump._update_scheduler.submit(seen.append,i)\r\n    pump._start_update_pump()\r\n    assert seen==list(range(1024))\r\n    pump._poll_updates();assert seen==list(range(1025))\r\n    assert pump.redraws==2\r\n\r\n\r\ndef test_destroy_stops_timer_rejects_submissions_and_stale_tick(pump):\r\n    pump._start_update_pump();timer=pump._update_poll_id;seen=[]\r\n    pump._update_scheduler.submit(seen.append,'stale')\r\n    pump.destroy()\r\n    assert not timer.isActive() and not pump._timers\r\n    pump._poll_updates();pump._start_update_pump();assert seen==[]\r\n    with pytest.raises(RuntimeError,match='closed'):pump._update_scheduler.submit(lambda:None)\r\n\r\n\r\ndef test_destroy_during_drain_discards_remaining_callbacks(pump):\r\n    seen=[];pump._update_scheduler.submit(pump.destroy)\r\n    pump._update_scheduler.submit(seen.append,'stale')\r\n    pump._start_update_pump()\r\n    assert pump._closed and seen==[] and pump.redraws==0\r\n    assert not pump._timers\r\n\r\n\r\ndef test_worker_cannot_drain_or_execute_callback(pump):\r\n    seen=[];pump._update_scheduler.submit(seen.append,'owner')\r\n    with ThreadPoolExecutor(max_workers=1) as pool:\r\n        with pytest.raises(RuntimeError,match='owning thread'):pool.submit(pump._poll_updates).result()\r\n    assert seen==[]\r\n    pump._poll_updates();assert seen==['owner']\r\n\r\n\r\ndef test_initial_callback_failure_does_not_leave_running_timer(pump):\r\n    def fail():raise ValueError('bad update')\r\n    pump._update_scheduler.submit(fail)\r\n    with pytest.raises(ValueError,match='bad update'):pump._start_update_pump()\r\n    assert pump._update_poll_id is None and not pump._timers\r\n    pump._start_update_pump();assert pump._update_poll_id.isActive()\r\n====\nfrom threading import Thread\n\nimport pytest\n\nfrom any3dview import ViewerScheduler\n\n\ndef test_scheduler_hands_cross_thread_payload_to_owner_thread():\n    scheduler = ViewerScheduler()\n    values = []\n    producer = Thread(target=scheduler.submit, args=(values.append, (\"frame\", 7)))\n    producer.start()\n    producer.join()\n\n    assert values == []\n    assert scheduler.drain() == 1\n    assert values == [(\"frame\", 7)]\n\n\ndef test_closed_scheduler_rejects_new_work():\n    scheduler = ViewerScheduler()\n    scheduler.close()\n    with pytest.raises(RuntimeError, match=\"closed\"):\n        scheduler.submit(lambda: None)\n", "durationMs": 0.0, "display": {"success": true, "verb": "Ran", "message": "grep -n \"_update_poll_id\\|_start_update_pump\\|def _poll_updates\\|def start\\b\\|_update_scheduler\" src/any3dview/retained_viewer.py | head -20; echo ====; cat tests/test_qt_update_pump.py; echo ====; cat tests/test_scheduler.py", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
{"id": "reasoning-7b87ad86-7dce-5b3d-8d64-d6f283d7fa75-0", "sessionId": "cd5bdcf9-05e0-4243-d3ad-2b4390b79841", "turnId": "turn-7d9b8318e9bf4a5caf8fd8005ae407bd", "createdAt": 1792407982583, "updatedAt": 1792407982583, "generationStatus": "completed", "relatedEntryId": null, "type": "reasoning", "text": "The old pump tests test the 2ms QTimer design — they need rewriting for the notifier design. Note `test_initial_callback_failure_does_not_leave_running_timer`: `_start_update_pump` drains first; a failing callback raises ValueError out of `_start_update_pump` — with my drain change (collect and re-raise at end), the ValueError still propagates from `_poll_updates` inside `_start_update_pump`. Good, but `_update_poll_id` must be None at that point — in the new design, `_start_update_pump` drains BEFORE creating notifier, so on failure `_update_notifier`/`_update_poll_id` stays None. Good.\n\nAlso `test_destroy_during_drain_discards_remaining_callbacks`: submit(pump.destroy) then submit(stale); _start_update_pump → drain runs destroy (which closes scheduler, clearing queue) → remaining \"stale\" discarded. With my drain change: destroy callback succeeds; next get_nowait → Empty (close cleared) → return. seen==[]. Good. But wait — destroy calls `self._update_scheduler.close()` — and drain is iterating... close drains the queue via get_nowait — fine with SimpleQueue.\n\nBut careful: with exception-collection drain, if a callback raises mid-drain, we continue and re-raise at end. In `_poll_updates` (qt), the exception propagates into customEvent. For the Qt notifier, should customEvent swallow? If it propagates, PySide6 prints traceback; in PySide6 >= 6.5, unhandled exceptions in Python event handlers call `sys.excepthook` then... Actually PySide6's default behavior: exceptions in slots/event handlers print traceback and the event loop continues (it uses `qFatal` only in some versions? PySide6 6.x: \"PySide6 will print the traceback and call qFatal\"? No — that's PyQt5's behavior for unhandled exceptions in slots (qFatal). PySide6 prints and continues? Hmm. In PySide6, an exception raised in a Python slot invoked from C++ is printed via traceback and the program continues... Actually since PySide6 6.0, unhandled exceptions in slots cause `sys.excepthook` to be called; the default excepthook prints; then control returns. I believe PySide6 doesn't abort. But there's risk.\n\nSafer design for the Qt host: `_poll_updates` catches drain exceptions? But then \"observable failure\" — the review wants callback exceptions to not strand remaining work (handled in drain) — observable failure of the callback itself: the exception propagates to the caller of drain. In the Qt path, the caller is customEvent. If PySide6 swallows/prints it, that's Qt's standard failure observability (traceback printed). I'll let it propagate — same as the old design where a callback exception in the 2ms QTimer timeout slot propagated. The old test `test_initial_callback_failure_does_not_leave_running_timer` expects the exception to propagate out of `_start_update_pump`. So propagation is the established contract. Keep it.\n\nNow the notifier coalescing design:\n\n```python\nclass _UpdateNotifier(QObject):\n    def __init__(self, owner, parent=None):\n        super().__init__(parent)\n        self._owner = owner\n        self._pending = False\n        self._lock = threading.Lock()\n\n    def wake(self):\n        with self._lock:\n            if self._pending:\n                return\n            self._pending = True\n        QCoreApplication.postEvent(self, _UpdateEvent())\n\n    def customEvent(self, event):\n        if event.type() is not _UPDATE_EVENT_TYPE:\n            return\n        with self._lock:\n            self._pending = False\n        owner = self._owner\n        if owner._closed:\n            return\n        owner._poll_updates()\n```\n\nNeed `import threading` in qt.py.\n\n`_start_update_pump` sets `self._update_scheduler.set_notifier(notifier.wake)`.\n\nEdge: notifier posted but viewer destroyed before delivery → customEvent checks owner._closed → return. Also destroy() should detach notifier: `self._update_scheduler.close()` detaches (close sets _notifier=None). Also pending posted events to a deleted QObject are discarded by Qt. Also `_update_poll_id = notifier` — check other uses of `_update_poll_id`: retained_viewer line 223 init None; used anywhere else? grep showed only 223, 244 (Tk reschedule). In qt.py `_start_update_pump` checks `self._update_poll_id is not None`. OK.\n\nNow scheduler changes:\n\n```python\nfrom threading import Lock, get_ident\n\n__slots__ = (\"_owner_thread\", \"_queue\", \"_closed\", \"_notifier\", \"_lock\", \"_notifier_error\")\n\ndef __init__(self):\n    ...\n    self._lock = Lock()\n    self._notifier_error = None\n\ndef submit(self, callback, /, *args, **kwargs):\n    if not callable(callback):\n        raise TypeError(\"callback must be callable\")\n    with self._lock:\n        if self._closed:\n            raise RuntimeError(\"viewer scheduler has been closed\")\n        self._queue.put((callback, args, kwargs))\n    notifier = self._notifier\n    if notifier is not None:\n        try:\n            notifier()\n        except Exception as error:\n            # The payload stays queued; record the wakeup failure so the\n            # owner thread observes it on the next drain instead of\n            # silently losing the wakeup.\n            if self._notifier_error is None:\n                self._notifier_error = error\n\ndef drain(self, limit=1024):\n    if get_ident() != self._owner_thread:\n        raise RuntimeError(...)\n    completed = 0\n    failure = None\n    while completed < max(1, int(limit)):\n        try:\n            callback, args, kwargs = self._queue.get_nowait()\n        except Empty:\n            break\n        try:\n            callback(*args, **kwargs)\n        except Exception as error:\n            if failure is None:\n                failure = error\n        completed += 1\n    if not self._queue.empty():\n        notifier = self._notifier\n        if notifier is not None:\n            try: notifier()\n            except Exception as error:\n                if self._notifier_error is None: self._notifier_error = error\n    error = self._notifier_error\n    if error is not None:\n        self._notifier_error = None\n        if failure is None:\n            failure = error  # hmm, or chain\n    if failure is not None:\n        raise failure\n    return completed\n```\n\nWait — order of raising: if a callback failed AND a notifier error was recorded, raise the callback failure (primary), keep notifier error? Or chain. Keep simple: callback failure takes precedence; notifier error stays recorded? If we clear it, it's lost. Let me raise callback failure and keep notifier error for next drain. Hmm, but then it lingers. Alternatively raise callback failure with context. Simplicity: if failure is None and notifier error exists → raise notifier error, clear it. If failure exists → raise failure, leave notifier error recorded (will surface next drain). Acceptable.\n\nHmm wait, but there's a subtlety with drain raising the notifier error: the Qt notifier's wake() rarely fails. Tests will use fake notifiers. Also `close()`:\n\n```python\ndef close(self):\n    with self._lock:\n        self._notifier = None\n        self._closed = True\n        while True:\n            try: self._queue.get_nowait()\n            except Empty: break\n    self._notifier_error = None\n```\n\nAtomic submit/close: submit holds lock while checking closed + put; close holds lock while setting closed + draining. Race eliminated: either submit's put happens before close's drain (item gets drained by close) or after (submit sees closed and raises). \n\nBut wait — old behavior: submit checked `self._closed` BEFORE callable check. Old code:\n```\nif self._closed: raise RuntimeError\nif not callable(callback): raise TypeError\n```\nI reordered callable check first — changes behavior for submit(non-callable) on closed scheduler: now raises TypeError instead of RuntimeError. Keep original order to be safe: check closed inside lock first, then callable. Actually callable check doesn't need the lock. Order: with lock: if closed raise RuntimeError; then check callable raise TypeError; then put (inside lock). Fine.\n\nAlso `pending()` unchanged.\n\nNow — \"an empty queue must not poll\": satisfied (no timer at all).\n\nNow the drain exception semantics vs existing test `test_initial_callback_failure_does_not_leave_running_timer`: drain raises ValueError after processing all — with only one failing callback, same behavior. Good.\n\nBut one more: drain's exception-safe continuation — \"a callback exception with more queued callbacks must still schedule remaining work\". With my design, drain continues processing remaining callbacks in the same call. And re-raises the first failure at the end. \n\nNow `_poll_updates` in qt.py: `completed = self._update_scheduler.drain(); if completed: self.redraw()`. If drain raises, redraw skipped — same as before.\n\nNow the software prep cache pruning. Where are meshes removed? Let me find `_remove_entry` or similar in retained_viewer: `handle.remove()` → callback `_mesh_changed(handle, \"remove\")`. Let me check `_mesh_changed` handling of \"remove\" — line ~1935. I saw part of the diff. Let me read `_mesh_changed` fully to know where entries are popped and chunk changes handled.", "summary": []}
{"id": "assistant-7b87ad86-7dce-5b3d-8d64-d6f283d7fa75", "sessionId": "cd5bdcf9-05e0-4243-d3ad-2b4390b79841", "turnId": "turn-7d9b8318e9bf4a5caf8fd8005ae407bd", "createdAt": 1792407982583, "updatedAt": 1792407982583, "generationStatus": "completed", "relatedEntryId": null, "type": "message", "role": "assistant", "content": [{"type": "text", "text": "Now reading `_mesh_changed` and the animation frame tail in retained_viewer.py to plan the reuse and pruning hooks precisely."}], "source": "harness", "userDisplayContent": null}
